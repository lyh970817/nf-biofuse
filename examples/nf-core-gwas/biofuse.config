/*
 * nf-biofuse for nf-core/gwas: serve one VCF Zarr store as the PLINK 1 trio of one cohort.
 *
 *   nextflow run nf-core/gwas -r <revision> -profile apptainer -c biofuse.config \
 *       --cohort_manifest cohort.biofuse.csv --analysis_manifest <analysis manifest> --outdir <results>
 *
 * Copy this file and cohort.biofuse.template.csv into the launch directory, then edit the store, the
 * template's cohort row and the supervisor path; everything else is optional. Relative paths are
 * relative to the launch directory.
 */

plugins {
    // Nextflow takes the plugin list from this file instead of adding to the pipeline's, so it repeats
    // the pipeline's own plugins. nf-schema@2.8.0 is what nf-core/gwas declares at the time of writing;
    // check `nextflow config nf-core/gwas -r <revision>` for the revision you run.
    id 'nf-schema@2.8.0'
    id 'nf-biofuse@0.1.0'
}

biofuse {
    // The store, and where the view's cohort manifest goes: the same file as --cohort_manifest.
    vcz              = '/data/cohort_a.vcz'
    manifestTemplate = 'cohort.biofuse.template.csv'
    manifest         = 'cohort.biofuse.csv'

    // The nf-biofuse-supervisor of the environment built from supervisor/environment.yml.
    supervisor       = '/opt/nf-biofuse-env/bin/nf-biofuse-supervisor'

    // A PLINK 1 view reconstructs FAM sex as a placeholder, so non-autosomal contigs are refused unless
    // the view is restricted to autosomes 1-22.
    autosomesOnly    = true

    // nf-core/gwas trusts the declared identity and never reads the trio to identify the cohort.
    identity         = 'declared'

    // Serving only; none of these enters the view identity.
    readaheadBufferSize = '64M'
    // stateRoot     = env('TMPDIR')      // node-local storage on a cluster node
}
